<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2：主页四宫格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学径"
        android:textColor="#7C8399"
        android:textSize="10sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/bCourse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5A5AD6" />
            <TextView
                android:id="@+id/tCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课表"
                android:textSize="10sp"
                android:textColor="#171A26"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bNote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0E9F8F" />
            <TextView
                android:id="@+id/tNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="笔记"
                android:textSize="10sp"
                android:textColor="#171A26"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/bTodo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="办"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E07A1F" />
            <TextView
                android:id="@+id/tTodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待办"
                android:textSize="10sp"
                android:textColor="#171A26"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bFocus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="钟"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E0505A" />
            <TextView
                android:id="@+id/tFocus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专注"
                android:textSize="10sp"
                android:textColor="#171A26"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
